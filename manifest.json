{
  "manifest_version": 3,
  "name": "LinkedIn Mass Unfollow",
  "version": "0.2.0",
  "description": "Select multiple profiles on LinkedIn's Following page and unfollow them in bulk.",
  "icons": {
    "16": "icons/linkedin_16.png",
    "32": "icons/linkedin_32.png",
    "48": "icons/linkedin_48.png",
    "128": "icons/linkedin_128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Mass Unfollow",
    "default_icon": {
      "16": "icons/linkedin_16.png",
      "32": "icons/linkedin_32.png"
    }
  },
  "permissions": ["tabs", "scripting", "activeTab"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/mynetwork/network-manager/people-follow/following*"
      ],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
