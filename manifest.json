{
  "manifest_version": 3,
  "name": "LinkedIn Mass Unfollow",
  "version": "0.2.0",
  "description": "Selecione vários perfis na página de Following do LinkedIn e faça unfollow em massa.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Mass Unfollow"
  },
  "permissions": ["tabs", "scripting", "activeTab"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/mynetwork/network-manager/people-follow/following*"
      ],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
